{
	"name": "@gradio/dataframe",
	"version": "1.0.28",
	"description": "Standalone Svelte Dataframe component usable outside the Gradio monorepo.",
	"type": "module",
	"main": "Index.svelte",
	"svelte": "Index.svelte",
	"types": "./types.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./types.d.ts",
			"svelte": "./Index.svelte",
			"default": "./Index.svelte"
		},
		"./shared/*": "./shared/*",
		"./package.json": "./package.json"
	},
	"files": [
		"Index.svelte",
		"shared/**/*",
		"dataframe.css",
		"theme.css",
		"stubs.ts",
		"stubs/**/*",
		"types.d.ts"
	],
	"scripts": {
		"build": "tsx build.ts",
		"dev": "vite dev",
		"preview": "vite preview"
	},
	"dependencies": {
		"@gradio/icons": "^0.3.4",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"svelte": "^5.0.0",
		"vite": "^5.0.0"
	},
	"peerDependencies": {
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"keywords": [
		"svelte",
		"dataframe",
		"table",
		"gradio",
		"standalone",
		"component"
	],
	"author": "Gradio Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/gradio-app/gradio.git"
	},
	"bugs": {
		"url": "https://github.com/gradio-app/gradio/issues"
	},
	"homepage": "https://github.com/gradio-app/gradio#readme"
}
